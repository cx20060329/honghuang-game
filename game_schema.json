{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "洪荒神话文字游戏数据架构",
  "description": "从龙凤大劫到巫妖大战的剧情游戏数据结构",

  "definitions": {
    "AttributeRange": {
      "type": "object",
      "description": "属性范围定义",
      "properties": {
        "min": { "type": "integer", "minimum": 0, "maximum": 100 },
        "max": { "type": "integer", "minimum": 0, "maximum": 100 },
        "default": { "type": "integer", "minimum": 0, "maximum": 100 }
      },
      "required": ["min", "max", "default"]
    },

    "CharacterAttributes": {
      "type": "object",
      "description": "角色五大属性",
      "properties": {
        "genjiao": { "$ref": "#/definitions/AttributeRange", "description": "根脚：出身背景，影响修炼速度和初始资源" },
        "qiyun": { "$ref": "#/definitions/AttributeRange", "description": "气运：影响事件触发概率和随机结果" },
        "daohang": { "$ref": "#/definitions/AttributeRange", "description": "道行：修炼境界，影响战斗力和法术" },
        "shengwang": { "$ref": "#/definitions/AttributeRange", "description": "声望：影响NPC态度和势力关系" },
        "xinxing": { "$ref": "#/definitions/AttributeRange", "description": "心性：影响决策选项和心魔事件" }
      },
      "required": ["genjiao", "qiyun", "daohang", "shengwang", "xinxing"]
    },

    "Item": {
      "type": "object",
      "description": "物品定义",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["法宝", "灵宝", "丹药", "材料", "典籍", "特殊"] },
        "rarity": { "type": "string", "enum": ["凡品", "灵品", "仙品", "先天灵宝", "混沌至宝"] },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "value": { "type": "number" },
              "description": { "type": "string" }
            }
          }
        },
        "description": { "type": "string" },
        "lore": { "type": "string", "description": "背景故事" }
      },
      "required": ["id", "name", "type", "rarity"]
    },

    "Relationship": {
      "type": "object",
      "description": "人物关系",
      "properties": {
        "characterId": { "type": "string" },
        "value": { "type": "integer", "minimum": -100, "maximum": 100, "description": "-100仇敌, 0中立, 100挚友" },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "关系标签：仇敌、挚友、道侣、师徒等"
        }
      },
      "required": ["characterId", "value"]
    },

    "Effect": {
      "type": "object",
      "description": "选项效果",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "attribute_change",
            "add_item",
            "remove_item",
            "relationship_change",
            "unlock_node",
            "set_flag",
            "trigger_event",
            "add_title",
            "learn_skill"
          ]
        },
        "target": { "type": "string", "description": "目标ID：属性名/物品ID/角色ID/节点ID" },
        "value": { "type": ["number", "string", "boolean"], "description": "变化值或设置值" },
        "condition": { "type": "string", "description": "触发条件表达式" }
      },
      "required": ["type", "target"]
    },

    "ChoiceCondition": {
      "type": "object",
      "description": "选项显示条件",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["attribute", "item", "relationship", "flag", "title", "skill"]
        },
        "target": { "type": "string" },
        "operator": { "type": "string", "enum": [">=", "<=", "==", "!=", ">", "<", "has", "not_has"] },
        "value": { "type": ["number", "string", "boolean"] }
      },
      "required": ["type", "target", "operator"]
    },

    "Choice": {
      "type": "object",
      "description": "剧情选项",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string", "description": "选项文本" },
        "description": { "type": "string", "description": "选项说明（可选）" },
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/definitions/ChoiceCondition" },
          "description": "显示条件（全部满足才显示）"
        },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/definitions/Effect" },
          "description": "选择后的效果"
        },
        "nextNodeId": { "type": "string", "description": "跳转到的节点ID" },
        "probability": {
          "type": "object",
          "description": "概率跳转（可选）",
          "properties": {
            "base": { "type": "number", "description": "基础概率" },
            "modifiedBy": { "type": "string", "description": "影响概率的属性" }
          }
        }
      },
      "required": ["id", "text", "nextNodeId"]
    },

    "StoryNode": {
      "type": "object",
      "description": "剧情节点",
      "properties": {
        "id": { "type": "string", "description": "节点唯一ID" },
        "chapter": { "type": "string", "description": "所属章节" },
        "phase": {
          "type": "string",
          "enum": [
            "prologue",
            "dragon_phoenix_war",
            "luohuo_fall",
            "hongjun_lecture",
            "wu_yao_rise",
            "buzhou_fall",
            "wu_yao_final",
            "epilogue"
          ],
          "description": "历史阶段"
        },
        "type": {
          "type": "string",
          "enum": ["story", "battle", "choice", "random_event", "milestone", "ending", "game_over"],
          "description": "节点类型：story=剧情, battle=战斗, choice=选择, random_event=随机事件, milestone=里程碑, ending=章节结局, game_over=游戏结束"
        },
        "title": { "type": "string" },
        "content": { "type": "string", "description": "剧情文本，支持{player_name}等变量" },
        "speaker": { "type": "string", "description": "说话者（可选）" },
        "choices": {
          "type": "array",
          "items": { "$ref": "#/definitions/Choice" },
          "description": "可选选项"
        },
        "autoNextId": { "type": "string", "description": "自动跳转节点（无选项时）" },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/definitions/Effect" },
          "description": "进入节点自动触发的效果"
        },
        "flags": {
          "type": "object",
          "description": "节点触发时设置的全局标记",
          "additionalProperties": { "type": "boolean" }
        },
        "characterRestrictions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "限定特定角色才能进入此节点"
        },
        "milestone": {
          "type": "string",
          "description": "里程碑标记（如：三族开战、罗睺陨落等）"
        },
        "endingId": {
          "type": "string",
          "description": "结局ID（仅type=ending时使用）"
        },
        "nextChapterId": {
          "type": "string",
          "description": "下一章节ID（仅type=ending时使用）"
        }
      },
      "required": ["id", "phase", "type", "title", "content"]
    },

    "Character": {
      "type": "object",
      "description": "可玩角色",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "title": { "type": "string", "description": "称号" },
        "faction": { "type": "string", "enum": ["妖族", "巫族", "先天神魔", "龙族", "凤族", "麒麟族"] },
        "attributes": { "$ref": "#/definitions/CharacterAttributes" },
        "startingItems": {
          "type": "array",
          "items": { "type": "string" },
          "description": "初始物品ID列表"
        },
        "startingRelationships": {
          "type": "array",
          "items": { "$ref": "#/definitions/Relationship" },
          "description": "初始人物关系"
        },
        "skills": {
          "type": "array",
          "items": { "type": "string" },
          "description": "初始技能ID列表"
        },
        "background": { "type": "string", "description": "背景故事" },
        "specialAbility": {
          "type": "object",
          "description": "角色特殊能力",
          "properties": {
            "name": { "type": "string" },
            "description": { "type": "string" },
            "trigger": { "type": "string" },
            "effect": { "type": "string" }
          }
        },
        "exclusiveNodes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "角色专属剧情节点ID"
        },
        "endings": {
          "type": "object",
          "description": "角色可能的结局",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "nodeId": { "type": "string" },
              "conditions": { "type": "array" },
              "description": { "type": "string" }
            }
          }
        }
      },
      "required": ["id", "name", "faction", "attributes", "background"]
    },

    "Timeline": {
      "type": "object",
      "description": "历史时间线",
      "properties": {
        "phase": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "startNode": { "type": "string", "description": "该阶段起始节点" },
        "endMilestone": { "type": "string", "description": "该阶段结束标志" },
        "historicalEvents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "mandatory": { "type": "boolean", "description": "是否必须发生" }
            }
          }
        }
      }
    }
  },

  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "lastUpdated": { "type": "string", "format": "date" },
        "author": { "type": "string" }
      }
    },

    "characters": {
      "type": "array",
      "items": { "$ref": "#/definitions/Character" },
      "description": "14名先天生灵角色数据"
    },

    "items": {
      "type": "array",
      "items": { "$ref": "#/definitions/Item" },
      "description": "游戏物品库"
    },

    "storyNodes": {
      "type": "array",
      "items": { "$ref": "#/definitions/StoryNode" },
      "description": "剧情节点库"
    },

    "timeline": {
      "type": "array",
      "items": { "$ref": "#/definitions/Timeline" },
      "description": "历史时间线定义"
    },

    "npcs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "title": { "type": "string" },
          "faction": { "type": "string" },
          "importance": { "type": "string", "enum": ["core", "major", "minor"] },
          "defaultRelationship": { "type": "integer" }
        }
      },
      "description": "NPC角色库（非玩家角色）"
    },

    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["攻击", "防御", "辅助", "被动"] },
          "description": { "type": "string" },
          "requirements": { "type": "object" }
        }
      },
      "description": "技能库"
    },

    "endings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["飞升", "陨落", "隐退", "称霸", "特殊"] },
          "description": { "type": "string" },
          "conditions": { "type": "array" }
        }
      },
      "description": "结局定义"
    }
  }
}
